      "writtenOn": "2018-11-19T22:37:24Z",
      "side": 1,
      "message": "How about we always use shorter interval if the device is charging? For example, the device is charging on the car with screen off. The user is using Google maps for navigation. The more accurate cell info helps determine the location.",
      "range": {
        "startLine": 294,
        "startChar": 49,
        "endLine": 294,
        "endChar": 60
      },
      "revId": "d4d3bb0e63c103d9c2448c4237cc9919226c90be",
