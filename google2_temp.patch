+    @Test
+    @SmallTest
+    public void testGetCellInfoDelayTime() throws Exception {
+        logd("testLocaleTracker");
+        long delay = getCellInfoDelayTime(0);
+        assertEquals(CELL_INFO_MIN_DELAY_MS, delay);
+        delay = getCellInfoDelayTime(100);
+        assertEquals(CELL_INFO_MAX_DELAY_MS, delay);
+    }
+
+    @Test
+    @SmallTest
+    public void test1() {
+        for (int i = 0; i < 100; i ++) {
+            logd("i =" + i + "res =" + getCellInfoDelayTime2(i));
+        }
+    }
+
+    private static final long CELL_INFO_MIN_DELAY_MS = 2 * 1000;
+    private static final long CELL_INFO_MAX_DELAY_MS = 10 * 1000 * 60;
+    private long getCellInfoDelayTime2(int failCount) {
+        // Exponentially grow the delay time
+        long delay = CELL_INFO_MIN_DELAY_MS * (long) Math.pow(2, failCount - 1);
+        logd("failCount = " + failCount + ", delay = " + delay);
+        if (delay < CELL_INFO_MIN_DELAY_MS) {
+            delay = CELL_INFO_MIN_DELAY_MS;
+        } else if (delay > CELL_INFO_MAX_DELAY_MS) {
+            delay = CELL_INFO_MAX_DELAY_MS;
+        }
+        return delay;
+    }
+
+    private long getCellInfoDelayTime(int failCount) throws Exception {
+        Class[] cArgs = new Class[1];
+        cArgs[0] = long.class;
+        Method method = LocaleTracker.class.getDeclaredMethod("getCellInfoDelayTime", cArgs);
+        method.setAccessible(true);
+        return (long) method.invoke(mLocaleTracker, failCount);
+    }
