      "writtenOn": "2018-01-31T23:34:24Z",
      "side": 1,
      "message": "This sort of does not match areAllApplicationsReady() and areAllRecordsLoaded(). If we feel this is the right check, then those methods should also return true only if mUiccApplications[0] \u003d\u003d null.",
      "range": {
        "startLine": 344,
        "startChar": 16,
        "endLine": 344,
