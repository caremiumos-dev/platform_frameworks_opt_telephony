        "id": 1125174
      },
      "writtenOn": "2017-11-21T18:47:59Z",
      "side": 1,
      "message": "I dont see VIDEO defined in CommandsInterface. Can you update the link?",
      "range": {
        "startLine": 614,
        "startChar": 20,
        "endLine": 614,
        "endChar": 68
      },
      "revId": "d02e1aeb7d1cb2cf622725b1a0623ab03ee72795",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "2e221a12_2e385c51",
        "filename": "src/java/com/android/internal/telephony/PhoneInternalInterface.java",
        "patchSetId": 1
      },
      "lineNbr": 614,
      "author": {
        "id": 1236087
      },
      "writtenOn": "2017-12-08T08:08:42Z",
      "side": 1,
      "message": "There is no VIDEO service class. SERVICE_CLASS_DATA_SYNC + SERVICE_CLASS_PACKET form the video service class. So, no modification is required in CommandsInterface link.",
      "parentUuid": "b82e094a_719bc939",
      "range": {
        "startLine": 614,
