        "id": 1125174
      },
      "writtenOn": "2017-11-21T18:58:06Z",
      "side": 1,
      "message": "I dont see the notify for Voice. Why are we adding this ?",
      "range": {
        "startLine": 1098,
        "startChar": 35,
        "endLine": 1098,
        "endChar": 64
      },
      "revId": "d02e1aeb7d1cb2cf622725b1a0623ab03ee72795",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "b2083f24_8c16d340",
        "filename": "src/java/com/android/internal/telephony/imsphone/ImsPhoneMmiCode.java",
        "patchSetId": 1
      },
      "lineNbr": 1098,
      "author": {
        "id": 1236087
      },
      "writtenOn": "2017-12-08T08:08:42Z",
      "side": 1,
      "message": "For Voice, it is not required explicitly, since notify is already taken care by existing API setVoiceCallForwardingFlag. (http://androidxref.com/8.0.0_r4/xref/frameworks/opt/telephony/src/java/com/android/internal/telephony/uicc/SIMRecords.java#566)",
      "parentUuid": "26078a41_44798354",
