      "writtenOn": "2017-02-01T01:27:41Z",
      "side": 1,
      "message": "private memeber of Phone, easy to access from internally and easy to mock for unit test?",
      "range": {
        "startLine": 1534,
        "startChar": 32,
        "endLine": 1534,
        "endChar": 55
      },
      "revId": "595a9b6ab334239580469869e6db385e62da38c5",
