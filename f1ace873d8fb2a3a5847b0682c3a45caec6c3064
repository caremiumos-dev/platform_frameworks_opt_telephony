      "writtenOn": "2019-04-11T18:40:46Z",
      "side": 1,
      "message": "If there is an active removable eUICC and an inactive built-in eUICC, we need to clarify whether we should set UNSUPPORTED or set the default to the removable eUICC.",
      "range": {
        "startLine": 855,
        "startChar": 34,
        "endLine": 855,
        "endChar": 65
      },
      "revId": "f1ace873d8fb2a3a5847b0682c3a45caec6c3064",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
