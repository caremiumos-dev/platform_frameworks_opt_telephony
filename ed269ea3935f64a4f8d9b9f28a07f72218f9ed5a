      "writtenOn": "2017-12-04T22:56:22Z",
      "side": 1,
      "message": "What is this behavior based on?",
      "range": {
        "startLine": 1734,
        "startChar": 20,
        "endLine": 1738,
        "endChar": 23
      },
      "revId": "ed269ea3935f64a4f8d9b9f28a07f72218f9ed5a",
