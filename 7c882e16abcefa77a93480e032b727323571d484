    {
      "key": {
        "uuid": "26111322_dde75b1e",
        "filename": "src/java/com/android/internal/telephony/uicc/UiccCard.java",
        "patchSetId": 1
      },
      "lineNbr": 667,
      "author": {
        "id": 1006780
      },
      "writtenOn": "2017-06-05T17:47:48Z",
      "side": 1,
      "message": "I\u0027ve occasionally seen the advice to be careful around using synchronized(this) \u003d\u003d synchronized methods, because the following scenarios can cause unexpected lock contention or even deadlock:\n\n-Someone external using a UiccCard instance as a lock object\n-Someone subclassing UiccCard and declaring synchronized methods\n\nWhere the problem with both of these is that they\u0027re impossible to detect just from looking at the source of UiccCard in isolation.\n\nIn the interest of that as well as keeping this change isolated to the minimum purpose it needs to serve, I think I\u0027d prefer to keep this as is unless the Telephony team feels more strongly.",
      "parentUuid": "c52f73e6_455dc4ae",
      "range": {
        "startLine": 667,
        "startChar": 22,
        "endLine": 667,
        "endChar": 27
      },
