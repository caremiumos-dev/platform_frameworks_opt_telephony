        "id": 1237921
      },
      "writtenOn": "2020-08-25T07:31:57Z",
      "side": 1,
      "message": "I may interpret the spec broadly. But we have implemented the feature like this for many years. So, would you please check with the carrier if it is acceptable just in case?\n\nIn parallel, I will update this CL with your solution.",
      "parentUuid": "544651f6_4d3fdab7",
      "range": {
        "startLine": 3275,
        "startChar": 63,
        "endLine": 3275,
        "endChar": 94
      },
      "revId": "7ef4cfe0dd38274f916e6af7fa6c1475a8b34b9d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
