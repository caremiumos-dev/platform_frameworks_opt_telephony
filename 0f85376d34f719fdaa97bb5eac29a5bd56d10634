    {
      "unresolved": true,
      "key": {
        "uuid": "48d6f914_e2a595cb",
        "filename": "src/java/com/android/internal/telephony/PhoneSwitcher.java",
        "patchSetId": 12
      },
      "lineNbr": 649,
      "author": {
        "id": 1081638
      },
      "writtenOn": "2021-03-09T01:56:40Z",
      "side": 1,
      "message": "You can\u0027t just abandon retry. This leaves phone switcher completely out of sync with the modem because mPhoneStates[], mPreferredDataPhoneId, etc... already switched to the new sub in onEvalulate.\n\nYou have few options.\n1. You should only change mPhoneStates[], mPreferredDataPhoneId to the new state when DDS switch succeeds, but this requires much larger architectural changes.\n2. Revert mPhoneStates[], mPreferredDataPhoneId back to its original values when failed, but it\u0027s very ugly. I would not recommend it.\n3. Just keep retrying as is for now, and we go with option 1 in next Android release. I think this is a better option.",
      "range": {
        "startLine": 646,
        "startChar": 0,
        "endLine": 649,
        "endChar": 17
      },
      "revId": "0f85376d34f719fdaa97bb5eac29a5bd56d10634",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
