        "id": 1081638
      },
      "writtenOn": "2021-03-02T09:18:32Z",
      "side": 1,
      "message": "PhoneSwitcher already registered for precise phone state, you can just use that instead of using another approach to check if there is any active call.",
      "range": {
        "startLine": 1496,
        "startChar": 0,
        "endLine": 1496,
