    {
      "key": {
        "uuid": "ea57dd1c_08c45adb",
        "filename": "src/java/com/android/internal/telephony/ServiceStateTracker.java",
        "patchSetId": 13
      },
      "lineNbr": 987,
      "author": {
        "id": 1054648
      },
      "writtenOn": "2018-09-07T00:00:26Z",
      "side": 1,
      "message": "It may be only 2-10 seconds old depending on the timeout value. Modem crashing does not mean the stale value is not good; the sync API can still return that. I would keep the value around except for the incorrect/misleading mLastCellInfoListTime. If that is the reason I guess this is ok, but should be mentioned in addition to this comment.",
      "parentUuid": "170f0d90_755a8b2a",
      "range": {
        "startLine": 986,
        "startChar": 20,
        "endLine": 987,
        "endChar": 79
