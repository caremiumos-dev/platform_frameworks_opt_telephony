    },
    {
      "unresolved": true,
      "key": {
        "uuid": "b933741c_ef4c4cfa",
        "filename": "src/java/com/android/internal/telephony/SubscriptionController.java",
        "patchSetId": 7
      },
      "lineNbr": 4544,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2021-11-15T18:19:33Z",
      "side": 1,
      "message": "It\u0027s incorrect not to allow someone to update the DB while the subscription is inactive (it\u0027s a settings database, after all), and this will also ensure that there are no odd races that occur. Btw, I copied this pattern from #setOpportunistic() which follows a lot of the same patterns.",
      "parentUuid": "04fed68c_67bca5a2",
      "range": {
        "startLine": 4544,
        "startChar": 12,
        "endLine": 4544,
        "endChar": 48
      },
      "revId": "1241276e35f62bc55b3b6de0fdfdcd986f39f657",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "549bc58c_1dbe4fb3",
        "filename": "src/java/com/android/internal/telephony/SubscriptionController.java",
