      "writtenOn": "2021-11-14T20:38:08Z",
      "side": 1,
      "message": "what is the usecase to update inactive subId setting",
      "range": {
        "startLine": 4544,
        "startChar": 12,
        "endLine": 4544,
        "endChar": 48
      },
      "revId": "1241276e35f62bc55b3b6de0fdfdcd986f39f657",
