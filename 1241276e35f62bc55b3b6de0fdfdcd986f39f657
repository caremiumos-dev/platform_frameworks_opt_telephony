      "writtenOn": "2021-11-14T20:38:08Z",
      "side": 1,
      "message": "do you not plan to update commands interface after the db update?",
      "range": {
        "startLine": 4562,
        "startChar": 5,
        "endLine": 4563,
        "endChar": 66
      },
      "revId": "1241276e35f62bc55b3b6de0fdfdcd986f39f657",
