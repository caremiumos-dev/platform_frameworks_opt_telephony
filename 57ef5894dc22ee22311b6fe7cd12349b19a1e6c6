      "writtenOn": "2019-12-15T07:20:09Z",
      "side": 1,
      "message": "what if some apn type changes from active -\u003e inactive.\nwill listeners getting notified about the state change?",
      "range": {
        "startLine": 2352,
        "startChar": 25,
        "endLine": 2352,
        "endChar": 42
      },
      "revId": "57ef5894dc22ee22311b6fe7cd12349b19a1e6c6",
