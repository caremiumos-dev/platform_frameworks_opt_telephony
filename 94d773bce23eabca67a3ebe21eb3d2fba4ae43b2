        "id": 1060151
      },
      "writtenOn": "2019-03-15T19:03:28Z",
      "side": 1,
      "message": "under what conditions could this be null? I\u0027m scared by the suddenness of this check. Maybe a different pre-existing bug?",
      "range": {
        "startLine": 1968,
        "startChar": 28,
        "endLine": 1968,
        "endChar": 41
      },
      "revId": "94d773bce23eabca67a3ebe21eb3d2fba4ae43b2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "6727b62a_b10db47b",
        "filename": "src/java/com/android/internal/telephony/dataconnection/DataConnection.java",
